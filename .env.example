# Garmin Connect Credentials
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_garmin_password

# Push target (used by push.sh) - the PC running your Obsidian vault
PUSH_USER=your_windows_user
PUSH_HOST=192.168.1.100
PUSH_DEST=C:/Users/your_windows_user/Documents/YourVaultName/

# Timezone for deciding "today" (IANA name). Leave out to use the machine's local timezone.
TIMEZONE=America/New_York
